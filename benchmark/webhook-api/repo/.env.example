PORT=3000
DATABASE_PATH=./payments.db
# Signing secret from the provider dashboard (Stripe: whsec_...). Required.
WEBHOOK_SECRET=whsec_test_local_secret
# Token clients must send as "Authorization: Bearer <token>" to read payments. Required.
API_TOKEN=local-dev-token
# Leave SMTP_URL empty to log emails to the console instead of sending them.
SMTP_URL=
EMAIL_FROM=payments@example.com
